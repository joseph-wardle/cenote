/target

# CMake build trees and the installed hdCenote plugin (see hydra/README.md)
/build/
/hydra/dist/

/*.exr

# Texture-prep caches, written beside their source images
*.dds

# VDB-prep caches (cenote-vdb-prep output), written beside their source
# .vdb files, plus the source-hash sidecar that validates them
*.nvdb
*.nvdb.src

# B11 volume assets (scenes/vdb/fetch.sh) — wdas_cloud's license is
# research/non-commercial, so like the kroken sources nothing here is
# ever committed
/scenes/vdb/sources/

# Research-corpus sources (scenes/corpus/fetch.sh) and the derived assets
# import writes beside the curated RONs — only the RONs, README.md, and
# fetch.sh are tracked there
/scenes/corpus/sources/
/scenes/corpus/*.exr

# CC-BY-ND scenes: the license withholds derivative distribution, so their
# RONs are derived assets too — curate-<name>.py regenerates them locally
/scenes/corpus/kroken.ron
/scenes/corpus/watercolor.ron

# The capped head scan the B9 driver scene traces — derived from the
# untracked head sources by curate-head.py, like the resampled skies
/scenes/corpus/head-capped.ply

# The curate scripts import field_order.py, and Python caches the bytecode
/scenes/corpus/__pycache__/

# Render output: scripts/benchmark.sh writes EXRs and stats sidecars wherever it
# is pointed. /restir-baselines/ holds captures from the removed ReSTIR
# estimator — nothing reads them; delete the directory to reclaim ~800 MB.
/restir-baselines/

# B7 shading-optimization gates: per-scene timing sidecars and the baked
# high-spp reference EXRs the relMSE oracle compares against. Machine-local
# (RTX 4070 Ti SUPER) — regenerate with scripts/b7-gates.sh.
/b7-baselines/

# B8 close captures: the 8e corpus sweep's EXRs and stats sidecars — the
# post-media baseline future milestones measure against. Machine-local,
# same class as /b7-baselines/.
/b8-baselines/

# Where scripts/corpus-identity.sh renders the sweep it byte-compares.
/corpus-identity/

# B9 subsurface captures: the walk drivers' cost, references, and relMSE,
# same class again. `probes-pinned/` is the exception in kind rather than
# in tracking — the walk's histograms are deterministic, so those files
# compare exactly across machines, but they still name a build.
/b9-baselines/

# B10 denoise and B11 volume captures — the same machine-local class.
/b10-baselines/
/b11-baselines/
