#usda 1.0
(
    """The first checkpoint stage (and the seed of the FLIP golden):
    two cubes at different depths from a real camera, lit by one distant
    light — every prim type the delegate translates so far, nothing it
    does not. The near cube is warm and left of center, the far cube cool
    and right, so a coarse silhouette check can tell them apart without
    pixel equality (tests/usdrecord_smoke.py)."""
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35
        double3 xformOp:translate = (0, -12, 0)
        float3 xformOp:rotateXYZ = (90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 3
        // Normalized, the intensity is the delivered irradiance itself;
        // unnormalized it would be the source's luminance, and the
        // default 0.53° disk would scale these 3 units down to darkness.
        bool inputs:normalize = 1
        float3 xformOp:rotateXYZ = (45, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Cube "Near"
    {
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.25, 0.15)]
        double3 xformOp:translate = (-1.2, -3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Far"
    {
        double size = 2
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.8)]
        double3 xformOp:translate = (1.5, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
