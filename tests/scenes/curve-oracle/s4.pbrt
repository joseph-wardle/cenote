# S4 -- b-spline, 6 control vertices, and pbrt's `flat` default.
#
# Three segments from six vertices, in the approximating basis Houdini
# exports: the control polygon is not the curve, so a basis read
# through the wrong matrix lands the strand somewhere else entirely.
#
# `flat` and `cylinder` are the same geometry in pbrt -- they differ
# only in the shading dpdv -- so leaving the default here costs the
# comparison nothing and proves the importer treats them alike.
#
# The rank: 256 strands, 4 pixels wide, on a 16-pixel pitch, against a
# 4096x512 film. README.md has the scene design; compare.py has the
# statistics and the limits they are held to.

Film "rgb"
    "integer xresolution" [ 4096 ]
    "integer yresolution" [ 512 ]

LookAt 0 0 -10.0
    0 0 0
    0 1 0

Camera "perspective"
    "float fov" [ 5.724810452 ]

Sampler "halton" "integer pixelsamples" [ 256 ]

Integrator "volpath" "integer maxdepth" [ 2 ]

# A box filter one pixel wide: coverage lands in the pixel it covers, so a
# marginal is a coverage profile and not a blurred one.
PixelFilter "box" "float xradius" [ .5 ] "float yradius" [ .5 ]

WorldBegin

# A uniform dome and a strand that reflects nothing: every pixel is
# L * (1 - coverage), so the image is an occlusion mask and the BSDF leaves
# the comparison entirely.
LightSource "infinite" "rgb L" [ 1 1 1 ]

Material "diffuse" "rgb reflectance" [ 0 0 0 ]

# Everything below is authored at half size and placed by this transform, so
# that a dropped or mis-composed CTM is a failure this instrument can see.
# Uniform scale has to reach the strand radii as well as the control points --
# in both renderers -- or the widths come out halved.
Scale 2 2 2
Shape "curve" "string basis" [ "bspline" ] "float width" [ 0.001953125 ] "point3 P" [ -0.997070312 -0.300000000 0 -0.995117188 -0.180000000 0 -0.997070312 -0.060000000 0 -0.995117188 0.060000000 0 -0.997070312 0.180000000 0 -0.995117188 0.300000000 0 ]
Shape "curve" "string basis" [ "bspline" ] "float width" [ 0.001953125 ] "point3 P" [ -0.989257812 -0.300000000 0 -0.987304688 -0.180000000 0 -0.989257812 -0.060000000 0 -0.987304688 0.060000000 0 -0.989257812 0.180000000 0 -0.987304688 0.300000000 0 ]
Shape "curve" "string basis" [ "bspline" ] "float width" [ 0.001953125 ] "point3 P" [ -0.981445312 -0.300000000 0 -0.979492188 -0.180000000 0 -0.981445312 -0.060000000 0 -0.979492188 0.060000000 0 -0.981445312 0.180000000 0 -0.979492188 0.300000000 0 ]
